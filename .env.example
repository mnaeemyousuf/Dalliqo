# ─────────────────────────────────────────────────────────────
# Stateown — API configuration
# Copy to server/.env for local runs, or to .env at the repo root
# for docker compose. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Must point at a replica set (transactions are used). docker compose provides one.
MONGO_URI=mongodb://localhost:27017/recrm?replicaSet=rs0
MONGO_AUTO_INDEX=true

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# true in production (HTTPS only)
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (for correct client IPs)
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true
# The shared address (sign-up, platform admin, the phone app's API). Links fall back to it.
APP_WEB_URL=http://localhost:5173
# SaaS: each agency at https://<subdomain>.<TENANT_BASE_DOMAIN>, e.g. stateown.pk. Leave empty for one shared address.
TENANT_BASE_DOMAIN=
LOG_LEVEL=info

# Email (required in production; in development mail is logged instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Stateown <no-reply@example.com>

# AI layer (optional). An Anthropic API key turns on the assistant and AI-written descriptions
# and client briefs; without it those use templates. Forecasts and price estimates need no key.
# Which AI provider to use (registered in server/src/services/ai/providers). Only "anthropic" today.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MONTHLY_LIMIT=3000

# WhatsApp Business Cloud API (optional). From Meta for Developers → your app → WhatsApp:
# a permanent system-user access token, the app secret (webhook signatures) and a verify token
# you choose for the webhook https://<api>/api/public/whatsapp/webhook. Each business then enters
# its phone number id in Settings → Website & WhatsApp. Without these, wa.me links are used.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Media storage: cloudinary (recommended in production) or local disk.
# Defaults to cloudinary when its credentials are set, otherwise local.
STORAGE_DRIVER=
UPLOAD_DIR=uploads
# Address phones/browsers use to reach this API (for links to locally stored files)
PUBLIC_API_URL=http://localhost:4000
MAX_IMAGE_MB=15
MAX_VIDEO_MB=100
MAX_DOCUMENT_MB=25
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Background jobs (follow-up reminders, overdue sweep). Always-on servers (VPS, Render): true.
JOBS_ENABLED=true
# Hosts without always-on timers (Hostinger web/cloud hosting): set JOBS_ENABLED=false and a secret here,
# then let a cron job call POST /api/internal/jobs every minute with the header X-Cron-Secret.
CRON_SECRET=

# Push notifications — service account from Firebase console
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional server key. The apps use their own platform-restricted Maps keys (see mobile/README.md).
GOOGLE_MAPS_API_KEY=

# ── Demo data only (npm run demo / npm run seed) ──
# Password for the six demo accounts. Set this before seeding any shared demo server.
# Never seed demo data into a customer's production database.
DEMO_PASSWORD=DEMO@1234
