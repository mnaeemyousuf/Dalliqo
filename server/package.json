{
  "name": "@recrm/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "prebuild": "cd ../shared && npm run build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "predev": "cd ../shared && npm run build",
    "dev": "tsx watch src/server.ts",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json",
