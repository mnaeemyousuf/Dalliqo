    "demo": "tsx src/scripts/demo.ts",
    "predemo": "cd ../shared && npm run build"
  },
  "dependencies": {
    "@recrm/shared": "*",
    "argon2": "^0.41.1",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^16.5.4",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "multer": "^1.4.5-lts.2",
